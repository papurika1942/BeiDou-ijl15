@echo off
rem Build a staged ezorsia dll with a chosen fusion tier (39/40/41/42).
rem Usage: build-tier.bat 41
rem ASCII only. The produced dll is copied to out\Release\ijl15-tierNN.dll
rem so it never clobbers the shipped ijl15.dll in the client folder.
setlocal
cd /d "%~dp0"
set TIER=%1
if "%TIER%"=="" set TIER=42

rem Write fusion_tier.h for this build.
>ezorsia\fusion_tier.h echo // generated by build-tier.bat tier %TIER%
>>ezorsia\fusion_tier.h echo #ifndef FUSION_TIER
>>ezorsia\fusion_tier.h echo #define FUSION_TIER %TIER%
>>ezorsia\fusion_tier.h echo #endif

echo ==== building TIER %TIER% ====
echo. | call "%~dp0build-release-x86.bat"
set RC=%errorlevel%

if not "%RC%"=="0" (
  echo TIER%TIER%_BUILD_FAILED rc=%RC%
  goto :restore
)

if exist "%~dp0out\Release\ijl15.dll" (
  copy /y "%~dp0out\Release\ijl15.dll" "%~dp0out\Release\ijl15-tier%TIER%.dll" >nul
  echo TIER%TIER%_OK
  for %%F in ("%~dp0out\Release\ijl15-tier%TIER%.dll") do echo   %%~nxF  %%~zF bytes
) else (
  echo TIER%TIER%_DLL_MISSING
)

:restore
rem Leave the source at the shipped default (42) so a plain build is unchanged.
>ezorsia\fusion_tier.h echo // generated by build-tier.bat (default)
>>ezorsia\fusion_tier.h echo #ifndef FUSION_TIER
>>ezorsia\fusion_tier.h echo #define FUSION_TIER 42
>>ezorsia\fusion_tier.h echo #endif
endlocal
